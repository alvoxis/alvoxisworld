{
  "name": "alvoxis-world-evolution",
  "version": "0.48.3",
  "private": true,
  "description": "ALVOXIS: World Evolution — a browser-based pixel-art sandbox god game.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && vite build",
    "bench": "vite-node scripts/bench.ts",
    "bench:sizes": "vite-node scripts/sizes.ts",
    "bench:civ": "vite-node scripts/civbench.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "8.2.2",
    "vite-node": "6.0.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "three": "^0.186.1"
  }
}
